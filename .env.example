# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Telefon için düşük gecikme: low önerilir
CLAUDE_EFFORT=low
# 1 yaparsanız daha hızlı (ve daha pahalı) "fast" mod
CLAUDE_FAST=0

# --- Sunucu ---
PORT=8080
# Twilio'nun ulaşacağı https adresi (ngrok, Render, Railway, VPS...)
PUBLIC_URL=https://ornek-alan-adi.com
# Uzun, rastgele bir değer yazın
RELAY_SECRET=
# Twilio Console > Account > Auth Token (imza doğrulaması için)
TWILIO_AUTH_TOKEN=
# "Çalışana aktar" denince aranacak numara, ör. +902120000000
TRANSFER_NUMBER=

# --- Ses (Twilio ConversationRelay) ---
TTS_PROVIDER=ElevenLabs
# ElevenLabs ses kimliği; isteğe bağlı model/hız/stabilite: <voiceId>-flash_v2_5-1.0_0.6_0.8
TTS_VOICE=
TTS_LANGUAGE=tr-TR
STT_PROVIDER=Deepgram
STT_MODEL=nova-3-general

# --- Halıflex ---
# mock = yerel deneme veritabanı, http = Halıflex API
HALIFLEX_MODE=mock
HALIFLEX_BASE_URL=
HALIFLEX_API_KEY=
